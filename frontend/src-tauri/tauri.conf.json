{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MEP Calculator",
  "version": "0.1.0",
  "identifier": "com.vikram.mepcalculator",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:8080",
